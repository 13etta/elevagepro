<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container reproduction-page">
  <section class="repro-header">
    <div>
      <h1>Reproduction Management</h1>
      <p>Suivez les chaleurs, saillies, gestations et mises bas attendues de votre programme d’élevage.</p>
    </div>
    <a class="repro-main-action" href="#record-mating">
      <span class="material-symbols-outlined">favorite</span>
      Enregistrer un événement
    </a>
  </section>

  <section class="repro-kpi-grid">
    <article class="repro-kpi repro-kpi-error">
      <span>Chaleurs récentes</span>
      <strong><%= heats.length %></strong>
      <small>femelles suivies</small>
      <i class="material-symbols-outlined">water_drop</i>
    </article>
    <article class="repro-kpi repro-kpi-secondary">
      <span>Saillies à confirmer</span>
      <strong><%= matings.length %></strong>
      <small>échographie à planifier</small>
      <i class="material-symbols-outlined">check_circle</i>
    </article>
    <article class="repro-kpi">
      <span>Gestations en cours</span>
      <strong><%= pregnancies.length %></strong>
      <small>mises bas attendues</small>
      <i class="material-symbols-outlined">child_friendly</i>
    </article>
  </section>

  <section class="repro-board-section">
    <div class="repro-section-title">
      <span class="material-symbols-outlined">view_kanban</span>
      <h2>Pipeline visuel reproduction</h2>
    </div>

    <div class="repro-board">
      <article class="repro-column">
        <header>
          <h3>Phase 1 : Chaleur</h3>
          <span><%= heats.length %></span>
        </header>
        <div class="repro-column-stack">
          <% if (!heats.length) { %>
            <div class="repro-empty-card">Aucune chaleur déclarée.</div>
          <% } %>
          <% heats.forEach((heat) => { %>
            <div class="repro-stage-card">
              <div class="repro-card-top">
                <span class="repro-chip error"><%= heat.stage || 'Suivi chaleur' %></span>
                <span class="material-symbols-outlined">more_horiz</span>
              </div>
              <div class="repro-dog-line">
                <span class="repro-avatar">
                  <% if (heat.photo_url) { %><img src="<%= heat.photo_url %>" alt="<%= heat.dog_name %>"><% } else { %><span class="material-symbols-outlined">pets</span><% } %>
                </span>
                <div>
                  <strong><%= heat.dog_name %></strong>
                  <small><%= heat.breed || 'Race non renseignée' %></small>
                </div>
              </div>
              <div class="repro-card-meta">
                <span class="material-symbols-outlined">calendar_today</span>
                <small>Début : <%= formatDate(heat.start_date) %></small>
              </div>
            </div>
          <% }) %>
        </div>
      </article>

      <article class="repro-column">
        <header>
          <h3>Phase 2 : Saillie</h3>
          <span><%= matings.length %></span>
        </header>
        <div class="repro-column-stack">
          <form id="record-mating" action="/reproduction/matings/new" method="POST" class="repro-mating-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="female_id" required>
              <option value="">Femelle</option>
              <% females.forEach((female) => { %><option value="<%= female.id %>"><%= female.name %></option><% }) %>
            </select>
            <select name="male_id" required>
              <option value="">Étalon</option>
              <% males.forEach((male) => { %><option value="<%= male.id %>"><%= male.name %></option><% }) %>
            </select>
            <input type="date" name="mating_date" required>
            <select name="method" required>
              <option value="naturelle">Naturelle</option>
              <option value="insémination">Insémination artificielle</option>
            </select>
            <button type="submit"><span class="material-symbols-outlined">add</span> Enregistrer</button>
          </form>

          <% if (!matings.length) { %>
            <div class="repro-empty-card">Aucune saillie en attente.</div>
          <% } %>
          <% matings.forEach((mating) => { %>
            <div class="repro-stage-card mating-card">
              <div class="repro-card-top">
                <span class="repro-chip secondary">À confirmer</span>
                <span class="material-symbols-outlined">more_horiz</span>
              </div>
              <div class="repro-pairing">
                <div>
                  <span class="repro-avatar small">
                    <% if (mating.female_photo_url) { %><img src="<%= mating.female_photo_url %>" alt="<%= mating.female_name %>"><% } else { %><span class="material-symbols-outlined">female</span><% } %>
                  </span>
                  <strong><%= mating.female_name %></strong>
                </div>
                <span class="repro-heart material-symbols-outlined">favorite</span>
                <div>
                  <span class="repro-avatar small">
                    <% if (mating.male_photo_url) { %><img src="<%= mating.male_photo_url %>" alt="<%= mating.male_name %>"><% } else { %><span class="material-symbols-outlined">male</span><% } %>
                  </span>
                  <strong><%= mating.male_name %></strong>
                </div>
              </div>
              <div class="repro-card-meta split">
                <span><span class="material-symbols-outlined">event</span><small><%= formatDate(mating.mating_date) %></small></span>
                <small><%= mating.method || 'méthode non renseignée' %></small>
              </div>
            </div>
          <% }) %>
        </div>
      </article>

      <article class="repro-column">
        <header>
          <h3>Phase 3 : Gestation</h3>
          <span><%= pregnancies.length %></span>
        </header>
        <div class="repro-column-stack">
          <% if (!pregnancies.length) { %>
            <div class="repro-empty-card">Aucune gestation en cours.</div>
          <% } %>
          <% pregnancies.forEach((pregnancy) => { %>
            <% const delivery = pregnancy.expected_delivery_date ? new Date(pregnancy.expected_delivery_date) : null; const today = new Date(); const total = 63; const remaining = delivery ? Math.max(0, Math.ceil((delivery - today) / (1000 * 60 * 60 * 24))) : null; const currentDay = remaining === null ? null : Math.min(total, Math.max(1, total - remaining)); const progress = currentDay ? Math.round((currentDay / total) * 100) : 0; %>
            <div class="repro-stage-card">
              <div class="repro-card-top">
                <span class="repro-chip secondary">Écho confirmée</span>
                <span class="material-symbols-outlined">more_horiz</span>
              </div>
              <div class="repro-dog-line">
                <span class="repro-avatar">
                  <% if (pregnancy.photo_url) { %><img src="<%= pregnancy.photo_url %>" alt="<%= pregnancy.female_name %>"><% } else { %><span class="material-symbols-outlined">pets</span><% } %>
                </span>
                <div>
                  <strong><%= pregnancy.female_name %></strong>
                  <small><%= remaining !== null ? 'J-' + remaining + ' avant terme' : 'Terme non renseigné' %></small>
                </div>
              </div>
              <div class="repro-progress">
                <div><span>J<%= currentDay || '-' %></span><span>J63</span></div>
                <div class="repro-progress-track"><span style="width:<%= progress %>%"></span></div>
              </div>
            </div>
          <% }) %>
        </div>
      </article>

      <article class="repro-column">
        <header>
          <h3>Phase 4 : Mise bas</h3>
          <span><%= pregnancies.filter((p) => { if (!p.expected_delivery_date) return false; const diff = Math.ceil((new Date(p.expected_delivery_date) - new Date()) / (1000 * 60 * 60 * 24)); return diff <= 7; }).length %></span>
        </header>
        <div class="repro-column-stack">
          <% const imminent = pregnancies.filter((p) => { if (!p.expected_delivery_date) return false; const diff = Math.ceil((new Date(p.expected_delivery_date) - new Date()) / (1000 * 60 * 60 * 24)); return diff <= 7; }); %>
          <% if (!imminent.length) { %>
            <div class="repro-empty-card">Aucune mise bas imminente.</div>
          <% } %>
          <% imminent.forEach((pregnancy) => { %>
            <div class="repro-stage-card imminent-card">
              <div class="repro-card-top">
                <span class="repro-chip primary pulse">Imminent</span>
                <span class="material-symbols-outlined">more_horiz</span>
              </div>
              <div class="repro-dog-line">
                <span class="repro-avatar danger">
                  <% if (pregnancy.photo_url) { %><img src="<%= pregnancy.photo_url %>" alt="<%= pregnancy.female_name %>"><% } else { %><span class="material-symbols-outlined">pets</span><% } %>
                </span>
                <div>
                  <strong><%= pregnancy.female_name %></strong>
                  <small>Terme : <%= formatDate(pregnancy.expected_delivery_date) %></small>
                </div>
              </div>
              <a class="repro-card-action" href="/pregnancies"><span class="material-symbols-outlined">medical_services</span> Ouvrir le suivi</a>
            </div>
          <% }) %>
        </div>
      </article>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>