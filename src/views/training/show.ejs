<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<% const money=v=>(Number(v)/100).toFixed(2)+' €'; const labels={draft:'Brouillon',accepted:'Accepté — acompte attendu',confirmed:'Confirmé',completed:'Terminé',cancelled:'Annulé'}; %>
<main class="container training-page">
<section class="page-hero"><div><p class="eyebrow"><%= job.quote_number %> · <%= labels[job.status] %></p><h1><%= job.dog_name %></h1><p><%= job.client_name %> — <%= job.service_label %><br><%= formatDate(job.start_date) %> → <%= formatDate(job.end_date) %></p></div><a class="btn" href="/calendar">Agenda</a></section>
<section class="kpi-grid"><article class="kpi-card"><span>Prix TTC</span><strong><%= money(job.price_cents) %></strong></article><article class="kpi-card"><span>Acompte exigé</span><strong><%= money(job.deposit_cents) %></strong></article><article class="kpi-card"><span>Encaissé net</span><strong><%= money(total.received) %></strong></article><article class="kpi-card"><span><%= job.status==='cancelled'?'Encaissement conservé':'Solde dû' %></span><strong><%= money(job.status==='cancelled'?total.received:job.price_cents-total.received) %></strong></article></section>
<section class="form-card"><h2>Documents</h2><a class="btn btn-primary" href="/training/<%= job.id %>/quote.pdf" target="_blank" rel="noopener">Ouvrir le devis à imprimer</a><div class="actions">
<% const docs=[['quote','Devis'],['contract','Contrat']]; if(total.deposits>=job.deposit_cents&&total.deposits>0&&job.status!=='cancelled') docs.push(['deposit-invoice','Facture d’acompte']); if(job.status==='completed') docs.push(['invoice','Facture finale']); docs.forEach(([kind,label])=>{ %>
<form action="/training/<%= job.id %>/documents/<%= kind %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn"><%= label %> PDF</button></form><% }); %></div></section>
<% if(job.status==='draft'){ %><section class="form-card"><h2>Acceptation du devis</h2><a class="btn" href="/training/<%= job.id %>/edit">Modifier le brouillon</a><form action="/training/<%= job.id %>/accept" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Référence du devis signé ou de l’accord du client<textarea name="acceptance_reference" maxlength="2000" required></textarea></label><button class="btn btn-primary">Enregistrer l’acceptation</button></form></section><% } %>
<% if(job.status!=='draft'){ %><section class="form-card"><h2><%= job.status==='cancelled'?'Enregistrer un remboursement':'Enregistrer un encaissement' %></h2><p>À saisir après réception effective du règlement. Une réservation est confirmée lorsque l’acompte exigé est entièrement encaissé.</p>
<form action="/training/<%= job.id %>/payments" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotency_key" value="<%= paymentKey %>">
<label>Nature<select name="kind"><% if(job.status==='cancelled'){ %><option value="refund">Remboursement</option><% }else{ %><% if(total.deposits<job.deposit_cents){ %><option value="deposit">Acompte</option><% } %><option value="balance">Solde / règlement complémentaire</option><% } %></select></label>
<label>Montant (€)<input type="number" name="amount" step="0.01" min="0.01" required></label><label>Date d’encaissement<input type="date" name="paid_on" required></label>
<label>Mode de paiement<select name="method"><option>Virement</option><option>Carte bancaire</option><option>Chèque</option><option>Espèces</option></select></label><label>Référence du règlement<input name="reference" maxlength="255" required></label><button class="btn btn-primary">Enregistrer</button></form></section><% } %>
<section class="table-block"><h2>Historique financier</h2><table><thead><tr><th>Date</th><th>Nature</th><th>Montant</th><th>Mode</th><th>Référence</th></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><%= formatDate(p.paid_on) %></td><td><%= {deposit:'Acompte',balance:'Solde',refund:'Remboursement'}[p.kind] %></td><td><%= p.kind==='refund'?'-':'' %><%= money(p.amount_cents) %></td><td><%= p.method %></td><td><%= p.reference %><% if(p.kind==='refund'){ %><form action="/training/<%= job.id %>/documents/credit" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="payment_id" value="<%= p.id %>"><button class="btn">Avoir PDF</button></form><% } %></td></tr><% }); %></tbody></table></section>
<% if(!['cancelled','completed'].includes(job.status)){ %><section class="form-card"><h2>Clôture</h2><form action="/training/<%= job.id %>/close" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(job.status==='confirmed'){ %><button class="btn" name="action" value="completed">Terminer la prestation</button><% } %> <button class="btn" name="action" value="cancelled">Annuler la prestation et les rendez-vous</button></form></section><% } %>
</main><%- include('../partials/foot') %>
