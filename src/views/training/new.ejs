<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/training.css">
<%- include('../partials/nav') %>
<% const detail=job.details||{}; const inputDate=v=>!v?'':v instanceof Date?v.toISOString().slice(0,10):String(v).slice(0,10); %>
<main class="container training-page">
<section class="page-hero"><div><p class="eyebrow">Prestations canines</p><h1><%= job.id?'Modifier le devis':'Ajouter un dressage' %></h1><p>Renseignez le dossier une seule fois. Le devis reprend ces informations et les coordonnées de votre élevage.</p></div><a class="btn" href="/training">Retour aux dressages</a></section>
<section class="form-card"><h2>Prestataire</h2><p><strong><%= breeder.company_name||breeder.name||'Élevage' %></strong><br><%= breeder.address||'Adresse à compléter dans les paramètres de l’élevage' %><br>SIRET : <%= breeder.siret||'À compléter dans les paramètres de l’élevage' %></p><a href="/breeder">Coordonnées de l’élevage</a></section>
<form action="<%= job.id?'/training/'+job.id+'/edit':'/training' %>" method="post" class="form-card" data-training-quote>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<h2>Référence et validité du devis</h2><p><%= job.quote_number||'Numéro attribué automatiquement à l’enregistrement' %></p>
<div class="training-form-grid"><label>Date du devis<input type="date" name="quote_date" value="<%= inputDate(job.quote_date) %>" required></label><label>Valable jusqu’au<input type="date" name="valid_until" value="<%= inputDate(job.valid_until) %>" required></label></div>
<h2>Propriétaire du chien</h2><div class="training-form-grid">
<% for(const [name,label,required,type] of [['client_name','Nom',true,'text'],['client_first_name','Prénom',false,'text'],['client_email','Courriel',false,'email'],['client_phone','Téléphone',true,'tel']]) { %><label><%= label %><input name="<%= name %>" type="<%= type %>" value="<%= (name==='client_first_name'?detail[name]:job[name])||'' %>" maxlength="255" <%= required?'required':'' %>></label><% } %></div>
<label>Adresse complète<textarea name="client_address" maxlength="2000" required><%= job.client_address||'' %></textarea></label>
<h2>Identification du chien</h2><div class="training-form-grid">
<% for(const [name,label] of [['dog_name','Nom du chien'],['dog_breed','Race'],['dog_chip','Numéro de puce ou tatouage']]) { %><label><%= label %><input name="<%= name %>" value="<%= job[name]||'' %>" maxlength="255" required></label><% } %>
<label>Sexe<select name="dog_sex"><option value="">À renseigner</option><option value="M" <%= detail.dog_sex==='M'?'selected':'' %>>Mâle</option><option value="F" <%= detail.dog_sex==='F'?'selected':'' %>>Femelle</option></select></label>
<label>Date de naissance<input type="date" name="dog_birth_date" value="<%= inputDate(detail.dog_birth_date) %>"></label><label>Numéro LOF, si applicable<input name="dog_lof" value="<%= detail.dog_lof||'' %>" maxlength="255"></label></div>
<h2>Prestation et objectifs</h2>
<label>Intitulé de la prestation<input name="service_label" value="<%= job.service_label||'' %>" maxlength="255" required list="training-services"><datalist id="training-services"><option value="Débourrage du chien d’arrêt"><option value="Dressage du chien d’arrêt"><option value="Mise en présence"><option value="Préparation à la compétition"><option value="Journée de travail"></datalist></label>
<label>Objectifs et travail convenus<textarea name="training_objectives" maxlength="4000" rows="4"><%= detail.training_objectives||'' %></textarea></label>
<div class="training-form-grid"><label>Accueil<select name="accommodation"><% ['','Sans nuitée','Avec pension complète','Autres modalités convenues'].forEach(v=>{ %><option value="<%= v %>" <%= detail.accommodation===v?'selected':'' %>><%= v||'Choisir' %></option><% }); %></select></label><label>Lieu de remise du chien<input name="handover_location" maxlength="255" value="<%= detail.handover_location||'' %>"></label></div>
<label>Ce qui est inclus dans le prix<textarea name="included_services" maxlength="4000" placeholder="Séances, pension, alimentation, oiseaux, suivi… selon votre offre"><%= detail.included_services||'' %></textarea></label>
<h2>Période et rendez-vous</h2><div class="training-form-grid">
<label>Début<input type="date" name="start_date" value="<%= inputDate(job.start_date) %>" required></label><label>Fin<input type="date" name="end_date" value="<%= inputDate(job.end_date) %>" required></label><label>Horaire de début<input type="time" name="start_time" value="<%= job.start_time?String(job.start_time).slice(0,5):'09:00' %>" required></label><label>Horaire de fin<input type="time" name="end_time" value="<%= job.end_time?String(job.end_time).slice(0,5):'17:00' %>" required></label></div>
<fieldset><legend>Jours de séance dans l’agenda</legend><% ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'].forEach((day,i)=>{ %><label><input type="checkbox" name="weekdays" value="<%= i %>" <%= (job.weekdays?job.weekdays.includes(i):i>=1&&i<=5)?'checked':'' %>><%= day %></label><% }); %></fieldset><p>Les rendez-vous seront créés après acceptation du devis et encaissement de l’acompte exigé.</p>
<h2>Prix et règlement</h2><div class="training-form-grid"><label>Prix total TTC (€)<input type="number" name="price" value="<%= job.price_cents==null?'':(job.price_cents/100).toFixed(2) %>" min="0.01" step="0.01" required></label><label>Acompte exigé (€)<input type="number" name="deposit" value="<%= job.deposit_cents==null?'':(job.deposit_cents/100).toFixed(2) %>" min="0" step="0.01" required></label><label>Taux de TVA (%)<input type="number" name="vat_rate" value="<%= job.vat_rate||0 %>" min="0" max="100" step="0.01" required></label></div>
<p data-training-totals aria-live="polite"></p><label>Mention fiscale applicable<textarea name="tax_note" maxlength="2000"><%= job.tax_note||'' %></textarea></label><label>Modalités et échéances de paiement<textarea name="payment_terms" maxlength="4000" placeholder="Échéance de l’acompte, date du solde, moyens de paiement acceptés"><%= detail.payment_terms||'' %></textarea></label>
<h2>Informations d’accueil du chien</h2><label>Santé et précautions<textarea name="health_notes" maxlength="4000" placeholder="Traitements, allergies, vaccins, précautions connues"><%= detail.health_notes||'' %></textarea></label><label>Alimentation et ration<textarea name="feeding_notes" maxlength="4000"><%= detail.feeding_notes||'' %></textarea></label><label>Vétérinaire habituel et coordonnées<input name="veterinarian" maxlength="255" value="<%= detail.veterinarian||'' %>"></label>
<section class="training-conditions" aria-labelledby="training-conditions-title">
  <h2 id="training-conditions-title">Conditions de la prestation</h2>
  <p>Les CGV du devis de référence sont préremplies. Les valeurs en bronze reprennent les données du dossier et les précisions ci-dessous.</p>
  <div class="training-conditions-fields">
    <% const quoteVariables = detail.quote_variables || {}; %>
    <% termsGroups.forEach(group => { %>
      <details class="training-conditions-group">
        <summary><%= group.title %></summary>
        <div class="training-form-grid">
          <% group.fields.forEach(([key,label,type]) => { %>
            <div class="form-group"><label for="cgv-<%= key %>"><%= label %></label>
              <input id="cgv-<%= key %>" class="training-bronze-field" name="cgv_<%= key %>" type="<%= type || 'text' %>" value="<%= quoteVariables[key] || '' %>" <%= type === 'number' ? 'min=0 step=0.01' : '' %> maxlength="2000">
            </div>
          <% }); %>
        </div>
      </details>
    <% }); %>
  </div>
  <details class="training-conditions-group training-terms-editor">
    <summary>Modifier les conditions convenues et CGV</summary>
    <div class="form-group">
    <label for="training-terms">Conditions convenues et CGV</label>
    <p class="muted">Le texte reste modifiable. Les repères entre doubles accolades sont remplacés par les valeurs du dossier à l’impression.</p>
    <textarea id="training-terms" name="terms" maxlength="12000" rows="16" required data-terms-editor><%= job.terms || '' %></textarea>
    <button type="button" class="btn btn-secondary" data-terms-reset>Reprendre les CGV du modèle</button>
    <textarea hidden data-terms-default><%= defaultTerms %></textarea>
    </div>
  </details>
  <details class="training-conditions-group" open>
    <summary>Aperçu des CGV avec les variables du dossier</summary>
    <p class="muted" data-terms-missing aria-live="polite"></p>
    <div class="training-terms-preview" data-terms-preview data-variables="<%= JSON.stringify(termsVariables) %>"></div>
  </details>
  <div class="form-group training-observations">
    <label for="training-notes">Observations complémentaires</label>
    <textarea id="training-notes" name="notes" maxlength="12000" rows="4"><%= job.notes || '' %></textarea>
  </div>
</section>
<div class="actions"><button class="btn btn-primary" name="next" value="print">Enregistrer et ouvrir le devis à imprimer</button><button class="btn btn-secondary" name="next" value="save">Enregistrer le dossier</button></div>
</form></main><script src="/js/training-quote.js" defer></script><script src="/js/training-terms.js" defer></script><%- include('../partials/foot') %>

