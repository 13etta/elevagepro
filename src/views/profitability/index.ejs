<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container profitability-page">
  <section class="page-hero">
    <div>
      <p class="eyebrow">Pilotage économique</p>
      <h1>Analyse de rentabilité</h1>
      <p>Suivez les revenus signés, les acomptes réellement encaissés, les charges et la marge par portée.</p>
    </div>
    <div class="form-actions">
      <a class="btn btn-secondary" href="/litters/new">Nouvelle portée</a>
      <a class="btn btn-secondary" href="/puppies/new">Ajouter un chiot</a>
      <a class="btn btn-primary" href="/sales/new">Nouvelle vente</a>
    </div>
  </section>

  <section class="dashboard-columns">
    <article class="card">
      <div class="section-title compact">
        <span class="section-kicker">Portée</span>
        <h2>Sélection</h2>
        <% if (selectedLitter) { %>
          <p class="muted"><%= selectedLitterLabel %><% if (selectedLitter.mother_breed) { %> · <%= selectedLitter.mother_breed %><% } %></p>
        <% } else { %>
          <p class="muted">Aucune portée sélectionnée. Créez ou sélectionnez une portée pour activer les calculs.</p>
        <% } %>
      </div>

      <% if (!litters.length) { %>
        <div class="empty-state">
          <strong>Aucune portée enregistrée</strong>
          <p>La rentabilité se calcule portée par portée. Commencez par créer une portée.</p>
          <a class="btn btn-primary" href="/litters/new">Créer une portée</a>
        </div>
      <% } else { %>
        <form method="GET" action="/profitability" class="stacked-form">
          <div class="form-group">
            <label for="litter_id">Portée analysée</label>
            <select id="litter_id" name="litter_id">
              <% litters.forEach((litter) => { %>
                <option value="<%= litter.id %>" <%= selectedLitter && String(selectedLitter.id) === String(litter.id) ? 'selected' : '' %>>
                  <%= litter.mother_name || 'Portée' %> — <%= formatDate(litter.birth_date) %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Analyser cette portée</button>
            <% if (selectedLitter) { %>
              <a class="btn btn-secondary" href="/litters/<%= selectedLitter.id %>">Ouvrir la portée</a>
            <% } %>
          </div>
        </form>
      <% } %>
    </article>

    <article class="card">
      <div class="section-title compact">
        <span class="section-kicker">Chiots</span>
        <h2>État commercial</h2>
      </div>
      <section class="kpi-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 0;">
        <a class="kpi-card profitability-link-card" href="/puppies"><span>Total</span><strong><%= puppyStats.total || 0 %></strong></a>
        <a class="kpi-card profitability-link-card" href="/puppies?status=disponible"><span>Disponibles</span><strong><%= puppyStats.available || 0 %></strong></a>
        <a class="kpi-card profitability-link-card" href="/puppies?status=reserve"><span>Réservés</span><strong><%= puppyStats.reserved || 0 %></strong></a>
        <a class="kpi-card profitability-link-card" href="/sales"><span>Vendus</span><strong><%= puppyStats.sold || 0 %></strong></a>
      </section>
    </article>
  </section>

  <section class="kpi-grid">
    <a class="kpi-card profitability-link-card" href="/sales"><span>CA signé</span><strong><%= Number(bookedRevenue || 0).toFixed(2) %> €</strong></a>
    <a class="kpi-card profitability-link-card" href="/sales"><span>Encaissement réel</span><strong><%= Number(paidRevenue || 0).toFixed(2) %> €</strong></a>
    <a class="kpi-card profitability-link-card" href="/sales/new"><span>CA prévisionnel</span><strong><%= Number(projectedRevenue || 0).toFixed(2) %> €</strong></a>
    <a class="kpi-card profitability-link-card" href="#profitability-expense-form"><span>Charges</span><strong><%= Number(totalExpenses || 0).toFixed(2) %> €</strong></a>
    <article class="kpi-card"><span>Marge réelle</span><strong><%= Number(cashProfit || 0).toFixed(2) %> €</strong></article>
    <article class="kpi-card"><span>Marge prévisionnelle</span><strong><%= Number(projectedProfit || 0).toFixed(2) %> €</strong></article>
    <article class="kpi-card"><span>Taux de marge</span><strong><%= marginRate || 0 %>%</strong></article>
    <article class="kpi-card"><span>Coût / chiot</span><strong><%= Number(costPerPuppy || 0).toFixed(2) %> €</strong></article>
  </section>

  <section class="dashboard-columns">
    <article class="card" id="profitability-expense-form">
      <div class="section-title compact">
        <span class="section-kicker">Charges</span>
        <h2>Ajouter une dépense</h2>
      </div>

      <% if (!hasLitter) { %>
        <div class="empty-state">
          <strong>Portée obligatoire</strong>
          <p>Créez ou sélectionnez une portée avant d’ajouter une charge.</p>
          <a class="btn btn-primary" href="/litters/new">Créer une portée</a>
        </div>
      <% } else { %>
        <form action="/profitability/expenses" method="POST" class="stacked-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="litter_id" value="<%= selectedLitter ? selectedLitter.id : '' %>">
          <div class="form-grid">
            <div class="form-group">
              <label>Date</label>
              <input type="date" name="expense_date" required value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="form-group">
              <label>Catégorie</label>
              <select name="category" required>
                <% expenseCategories.forEach(([value, label]) => { %>
                  <option value="<%= value %>"><%= label %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label>Rattacher à un chiot</label>
              <select name="puppy_id">
                <option value="">Charge générale portée</option>
                <% puppies.forEach((puppy) => { %>
                  <option value="<%= puppy.id %>"><%= puppy.name || 'Chiot sans nom' %> · <%= puppy.sex || '-' %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>Montant (€)</label>
              <input type="number" step="0.01" min="0.01" name="amount" required>
            </div>
          </div>
          <div class="form-group">
            <label>Libellé</label>
            <input type="text" name="label" required placeholder="Ex : croquettes chiots, visite vétérinaire, vaccin...">
          </div>
          <div class="form-group">
            <label>Note</label>
            <input type="text" name="notes">
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Ajouter la charge</button>
          </div>
        </form>
      <% } %>
    </article>

    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Ventes</span>
        <h2>Revenus de la portée</h2>
        <p class="muted">Acomptes : <%= Number(depositRevenue || 0).toFixed(2) %> € · Reste prévisionnel non vendu : <%= Number(projectedUnsoldRevenue || 0).toFixed(2) %> €</p>
        <div class="form-actions" style="justify-content:flex-start; margin-top:10px;">
          <a class="btn btn-primary" href="/sales/new">Ajouter une vente</a>
          <a class="btn btn-secondary" href="/sales">Voir les ventes</a>
        </div>
      </div>
      <% if (!sales.length) { %>
        <div class="empty-state">
          <strong>Aucune vente</strong>
          <p>Aucune vente ou réservation rattachée à cette portée.</p>
          <a class="btn btn-primary" href="/sales/new">Créer une vente</a>
        </div>
      <% } else { %>
        <table>
          <thead><tr><th>Chiot</th><th>Acquéreur</th><th>Prix</th><th>Acompte</th><th>Statut</th><th>Action</th></tr></thead>
          <tbody>
            <% sales.forEach((sale) => { %>
              <tr>
                <td><%= sale.puppy_name || '-' %></td>
                <td><%= sale.buyer_name || '-' %></td>
                <td><strong><%= Number(sale.price || 0).toFixed(2) %> €</strong></td>
                <td><%= Number(sale.deposit_amount || 0).toFixed(2) %> €</td>
                <td><span class="badge"><%= sale.is_reservation ? 'Réservation' : 'Vente définitive' %></span></td>
                <td><a class="btn btn-secondary" href="/sales/<%= sale.id %>/edit">Ouvrir</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>
  </section>

  <section class="dashboard-columns">
    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Chiots</span>
        <h2>Détail commercial</h2>
        <div class="form-actions" style="justify-content:flex-start; margin-top:10px;">
          <a class="btn btn-primary" href="/puppies/new">Ajouter un chiot</a>
          <a class="btn btn-secondary" href="/puppies">Voir les chiots</a>
        </div>
      </div>
      <% if (!puppies.length) { %>
        <div class="empty-state">
          <strong>Aucun chiot</strong>
          <p>Ajoutez les chiots dans la portée pour obtenir une rentabilité fiable.</p>
          <a class="btn btn-primary" href="/puppies/new">Ajouter un chiot</a>
        </div>
      <% } else { %>
        <table>
          <thead><tr><th>Chiot</th><th>Sexe</th><th>Robe</th><th>Statut</th><th>Prix fiche</th><th>Action</th></tr></thead>
          <tbody>
            <% puppies.forEach((puppy) => { %>
              <tr>
                <td><%= puppy.name || 'Sans nom' %></td>
                <td><%= puppy.sex || '-' %></td>
                <td><%= puppy.color || '-' %></td>
                <td><span class="badge"><%= puppy.status || 'Disponible' %></span></td>
                <td><%= Number(puppy.sale_price || 0).toFixed(2) %> €</td>
                <td><a class="btn btn-secondary" href="/puppies/<%= puppy.id %>/edit">Ouvrir</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>

    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Charges</span>
        <h2>Répartition</h2>
      </div>
      <% if (!expenseByCategory.length) { %>
        <div class="empty-state">
          <strong>Aucune répartition</strong>
          <p>Les catégories apparaîtront dès les premières charges.</p>
          <a class="btn btn-primary" href="#profitability-expense-form">Ajouter une charge</a>
        </div>
      <% } else { %>
        <table>
          <thead><tr><th>Catégorie</th><th>Montant</th></tr></thead>
          <tbody>
            <% expenseByCategory.forEach((item) => { %>
              <tr><td><span class="badge"><%= item.label %></span></td><td><strong><%= Number(item.amount || 0).toFixed(2) %> €</strong></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>
  </section>

  <section class="table-block">
    <div class="section-title compact">
      <span class="section-kicker">Historique</span>
      <h2>Charges enregistrées</h2>
    </div>
    <% if (!expenses.length) { %>
      <div class="empty-state">
        <strong>Aucune charge</strong>
        <p>Ajoutez les charges liées à la portée pour calculer une marge réaliste.</p>
        <a class="btn btn-primary" href="#profitability-expense-form">Ajouter une charge</a>
      </div>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Catégorie</th><th>Libellé</th><th>Rattachement</th><th>Montant</th><th>Action</th></tr></thead>
        <tbody>
          <% expenses.forEach((expense) => { %>
            <tr>
              <td><%= formatDate(expense.expense_date) %></td>
              <td><span class="badge"><%= expense.category %></span></td>
              <td><%= expense.label %><% if (expense.notes) { %><br><small class="muted"><%= expense.notes %></small><% } %></td>
              <td><%= expense.puppy_name || expense.dog_name || 'Portée' %></td>
              <td><strong><%= Number(expense.amount || 0).toFixed(2) %> €</strong></td>
              <td>
                <form method="POST" action="/profitability/expenses/<%= expense.id %>/delete" onsubmit="return confirm('Supprimer cette charge ?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary">Supprimer</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>

<%- include('../partials/foot') %>