<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container dashboard-stitch">
  <section class="page-hero dashboard-titlebar">
    <div>
      <h1>Pilotage d'élevage canin</h1>
      <p><span class="material-symbols-outlined">verified</span> Cockpit professionnel de l'élevage</p>
    </div>
    <div class="hero-actions">
      <a class="btn btn-secondary" href="/soins"><span class="material-symbols-outlined">add_circle</span> Ajouter un soin</a>
      <a class="btn btn-primary" href="/dogs/new"><span class="material-symbols-outlined">pets</span> Nouveau chien</a>
    </div>
  </section>

  <% if (typeof alerts !== 'undefined' && alerts.length) { %>
    <section class="alert-grid stitch-alert-strip">
      <% alerts.forEach((alert) => { %>
        <a class="business-alert alert-<%= alert.level %>" href="<%= alert.href %>">
          <span class="material-symbols-outlined"><%= alert.level === 'danger' ? 'warning' : alert.level === 'warning' ? 'report' : 'info' %></span>
          <strong><%= alert.title %></strong>
        </a>
      <% }) %>
    </section>
  <% } %>

  <section class="dashboard-kpi-grid stitch-kpis">
    <article class="kpi-card">
      <span>Chiens actifs</span>
      <strong><%= kpis.activeDogs %></strong>
    </article>
    <article class="kpi-card">
      <span>Portées en cours</span>
      <strong><%= kpis.activeLitters %></strong>
    </article>
    <article class="kpi-card">
      <span>Chiots dispo.</span>
      <strong><%= kpis.availablePuppies %></strong>
    </article>
    <article class="kpi-card kpi-warning">
      <span>Rappels de soins</span>
      <strong><%= kpis.upcomingReminders %></strong>
    </article>
    <article class="kpi-card">
      <span>Ventes en attente</span>
      <strong><%= kpis.incompleteSales %></strong>
    </article>
    <article class="kpi-card kpi-revenue">
      <span>Revenu mensuel</span>
      <strong><%= formatCurrency(kpis.currentMonthSales) %></strong>
    </article>
  </section>

  <section class="dashboard-columns stitch-main-grid">
    <article class="table-block dashboard-sales-panel stitch-chart-card">
      <div class="section-title compact">
        <h2>Performances Financières</h2>
        <p class="muted">Revenus des ventes et réservations</p>
        <a href="/sales" class="report-link">Voir le rapport <span class="material-symbols-outlined">arrow_forward</span></a>
      </div>

      <% if (!salesSeries || !salesSeries.length) { %>
        <p class="muted empty-chart-text">Aucune donnée de vente à afficher.</p>
      <% } else { %>
        <div class="mini-bar-chart" aria-label="Graphique des ventes mensuelles">
          <% salesSeries.forEach((item) => { %>
            <div class="mini-bar-item">
              <div class="mini-bar-track">
                <div class="mini-bar-fill" style="height:<%= Math.max(5, Math.round((item.total / maxMonthlySales) * 100)) %>%"></div>
              </div>
              <small><%= item.label %></small>
            </div>
          <% }) %>
        </div>
      <% } %>
    </article>

    <article class="card stitch-alert-card">
      <div class="section-title compact alert-heading">
        <span class="material-symbols-outlined">warning</span>
        <h2>Alertes Actives</h2>
      </div>
      <div class="alert-list">
        <% if (alerts && alerts.length) { %>
          <% alerts.slice(0, 5).forEach((alert) => { %>
            <a href="<%= alert.href %>" class="alert-item alert-<%= alert.level %>">
              <span class="material-symbols-outlined"><%= alert.level === 'danger' ? 'vaccines' : alert.level === 'warning' ? 'hourglass_top' : 'description' %></span>
              <strong><%= alert.title %></strong>
              <small>Action requise</small>
            </a>
          <% }) %>
        <% } else if (reminders && reminders.length) { %>
          <% reminders.slice(0, 3).forEach((row) => { %>
            <a href="/reminders" class="alert-item">
              <span class="material-symbols-outlined">notifications_active</span>
              <strong><%= row.label %></strong>
              <small><%= row.dog_name || __('common.general') %> · <%= formatDate(row.due_date) %></small>
            </a>
          <% }) %>
        <% } else { %>
          <p class="muted">Aucune alerte active.</p>
        <% } %>
      </div>
      <a class="btn btn-secondary full-width" href="/reminders">Voir tout (<%= kpis.upcomingReminders %>)</a>
    </article>
  </section>

  <section class="dashboard-columns dashboard-priority-zone">
    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Santé</span>
        <h2>Derniers soins</h2>
      </div>
      <% if (!soins.length) { %>
        <p class="muted table-empty">Aucun soin récent.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Type</th><th>Chien</th></tr></thead>
          <tbody>
            <% soins.forEach((row) => { %>
              <tr>
                <td><%= formatDate(row.event_date) %></td>
                <td><%= row.label || row.type %></td>
                <td><%= row.dog_name || __('common.general') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>

    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Commercial</span>
        <h2>Dernières ventes</h2>
      </div>
      <% if (!sales.length) { %>
        <p class="muted table-empty">Aucune vente récente.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Acquéreur</th><th>Montant</th></tr></thead>
          <tbody>
            <% sales.forEach((sale) => { %>
              <tr>
                <td><%= formatDate(sale.sale_date) %></td>
                <td><%= sale.buyer_firstname || '-' %></td>
                <td><%= formatCurrency(sale.total_price) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>
  </section>

  <section class="module-cockpit">
    <div class="section-title">
      <span class="section-kicker">Modules</span>
      <h2>Accès rapides</h2>
    </div>

    <div class="module-grid">
      <% modules.filter((module) => module.key !== 'dashboard').forEach((module) => { %>
        <a class="module-card accent-<%= module.accent %>" href="<%= module.href %>">
          <span class="module-icon"><%= module.icon %></span>
          <strong><%= __(module.labelKey) %></strong>
          <p><%= __(module.descriptionKey) %></p>
        </a>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/foot') %>