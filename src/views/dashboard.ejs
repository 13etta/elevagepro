<%- include('partials/head') %>
<%- include('partials/nav') %>

<main id="main-content" tabindex="-1" class="container dashboard-stitch horizon-dashboard">
  <section class="page-hero dashboard-titlebar"><div class="horizon-edition" aria-hidden="true"><span>ELEVAGEPRO</span><span>LE QUOTIDIEN</span></div>
    <div>
      <p class="eyebrow">LE CARNET DE VOTRE ÉLEVAGE</p>
      <h1>Bonjour<%= user && user.full_name ? ' ' + user.full_name.trim().split(/\s+/)[0] : '' %>.</h1>
      <p>Chaque jour écrit la suite. Prenez soin de l’essentiel.</p>
    </div>
    <div class="hero-actions">
      <a class="btn btn-secondary" href="/calendar/new"><span class="material-symbols-outlined">event</span> Ajouter une échéance</a>
      <a class="btn btn-primary" href="/dogs/new"><span class="material-symbols-outlined">pets</span> Nouveau chien</a>
    </div>
  </section>

  <div class="horizon-section-heading"><span>01 / À VOTRE ATTENTION</span><a href="/calendar">Voir mon agenda ↗</a></div><section class="daily-workspace">
    <article class="card stitch-alert-card">
      <div class="section-title compact alert-heading">
        <span class="material-symbols-outlined">warning</span>
        <h2>Vos priorités</h2>
      </div>
      <div class="alert-list">
        <% if (alerts && alerts.length) { %>
          <% alerts.forEach((alert) => { %>
            <a href="<%= alert.href %>" class="alert-item alert-<%= alert.level %>">
              <span class="material-symbols-outlined"><%= alert.level === 'danger' ? 'vaccines' : alert.level === 'warning' ? 'hourglass_top' : 'description' %></span>
              <strong><%= alert.title %></strong>
              <small>Action requise</small>
            </a>
          <% }) %>
        <% } else if (reminders && reminders.length) { %>
          <% reminders.slice(0, 3).forEach((row) => { %>
            <a href="/reminders" class="alert-item">
              <span class="material-symbols-outlined">notifications_active</span>
              <strong><%= row.label %></strong>
              <small><%= row.dog_name || __('common.general') %> · <%= formatDate(row.due_date) %></small>
            </a>
          <% }) %>
        <% } else { %>
          <p class="muted">Aucune alerte active.</p>
        <% } %>
      </div>
      <a class="btn btn-secondary full-width" href="/reminders">Consulter les rappels (<%= kpis.upcomingReminders %>)</a>
    </article>
<article class="card daily-followup"><span class="section-kicker">Votre prochain geste</span><h2>Le suivi de votre élevage</h2><a class="work-shortcut" href="/reproduction"><span class="material-symbols-outlined">hub</span><span><strong>Reproduction</strong><small><%= kpis.ongoingPregnancies || 0 %> gestation(s) en cours</small></span><span aria-hidden="true">→</span></a><a class="work-shortcut" href="/weights"><span class="material-symbols-outlined">monitor_weight</span><span><strong>Peser les chiots</strong><small>Ouvrir les courbes et enregistrer un poids</small></span><span aria-hidden="true">→</span></a><a class="work-shortcut" href="/calendar"><span class="material-symbols-outlined">event</span><span><strong>Préparer les échéances</strong><small>Rendez-vous et engagements à venir</small></span><span aria-hidden="true">→</span></a></article></section>
  <div class="horizon-section-heading"><span>02 / L’ÉLEVAGE EN CHIFFRES</span></div><section class="dashboard-kpi-grid stitch-kpis">
    <a class="kpi-card" href="/dogs">
      <span>Chiens actifs</span>
      <strong><%= kpis.activeDogs %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
    <a class="kpi-card" href="/litters">
      <span>Portées en cours</span>
      <strong><%= kpis.activeLitters %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
    <a class="kpi-card" href="/puppies">
      <span>Chiots disponibles</span>
      <strong><%= kpis.availablePuppies %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
    <a class="kpi-card kpi-warning" href="/reminders">
      <span>Rappels de soins</span>
      <strong><%= kpis.upcomingReminders %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
    <a class="kpi-card" href="/sales">
      <span>Ventes en attente</span>
      <strong><%= kpis.incompleteSales %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
    <a class="kpi-card kpi-revenue" href="/profitability">
      <span>Revenu mensuel</span>
      <strong><%= formatCurrency(kpis.currentMonthSales) %></strong>
    <small class="kpi-destination">Consulter <span aria-hidden="true">↗</span></small></a>
  </section>

  <div class="horizon-section-heading"><span>03 / L’ACTIVITÉ</span></div><section class="dashboard-columns daily-sales">
    <article class="table-block dashboard-sales-panel stitch-chart-card">
      <div class="section-title compact">
        <h2>Activité commerciale</h2>
        <p class="muted">Revenus des ventes et réservations</p>
        <a href="/sales" class="report-link">Voir le rapport <span class="material-symbols-outlined">arrow_forward</span></a>
      </div>

      <% if (!salesSeries || !salesSeries.length) { %>
        <p class="muted empty-chart-text">Aucune donnée de vente à afficher.</p>
      <% } else { %>
        <div class="mini-bar-chart" role="list" aria-label="Montants des ventes par mois">
          <% salesSeries.forEach((item) => { %>
            <div class="mini-bar-item" role="listitem">
              <strong><%= formatCurrency(item.total) %></strong>
              <div class="mini-bar-track">
                <div class="mini-bar-fill" style="height:<%= maxMonthlySales > 0 ? Math.max(0, Math.round((item.total / maxMonthlySales) * 100)) : 0 %>%"></div>
              </div>
              <small><%= item.label %></small>
            </div>
          <% }) %>
        </div>
      <% } %>
    </article>


  </section>

  <section class="dashboard-columns dashboard-priority-zone">
    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Santé</span>
        <h2>Derniers soins</h2>
      </div>
      <% if (!soins.length) { %>
        <p class="muted table-empty">Aucun soin récent.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Type</th><th>Chien</th></tr></thead>
          <tbody>
            <% soins.forEach((row) => { %>
              <tr>
                <td><%= formatDate(row.event_date) %></td>
                <td><%= row.label || row.type %></td>
                <td><%= row.dog_name || __('common.general') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>

    <article class="table-block">
      <div class="section-title compact">
        <span class="section-kicker">Commercial</span>
        <h2>Dernières ventes</h2>
      </div>
      <% if (!sales.length) { %>
        <p class="muted table-empty">Aucune vente récente.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Acquéreur</th><th>Montant</th></tr></thead>
          <tbody>
            <% sales.forEach((sale) => { %>
              <tr>
                <td><%= formatDate(sale.sale_date) %></td>
                <td><%= sale.buyer_firstname || '-' %></td>
                <td><%= formatCurrency(sale.total_price) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>
  </section>

  <section class="table-block">
    <div class="section-title compact calendar-list-title">
      <div>
        <span class="section-kicker">Calendrier</span>
        <h2>Prochaines échéances cynophiles</h2>
      </div>
      <a class="btn btn-secondary" href="/calendar">Ouvrir le calendrier</a>
    </div>
    <% if (!calendarEvents || !calendarEvents.length) { %>
      <p class="muted table-empty">Aucun concours, rendez-vous ou engagement à venir.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Événement</th><th>Chien(s)</th><th>Lieu</th><th>Action</th></tr></thead>
        <tbody>
          <% calendarEvents.forEach((event) => { %>
            <tr>
              <td><strong><%= formatDate(event.event_date) %></strong></td>
              <td><span class="event-category"><%= String(event.category || '').replace('_', ' ') %></span><br><strong><%= event.title %></strong></td>
              <td><%= event.dog_names || 'Élevage' %></td>
              <td><%= event.location || '-' %></td>
              <td><a class="btn btn-secondary" href="/calendar/<%= event.id %>/edit">Préparer</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="module-cockpit">
    <div class="section-title">
      <span class="section-kicker">Votre espace de travail</span>
      <h2>Chaque métier, à sa place.</h2>
    </div>

    <div class="module-grid">
      <% modules.filter((module) => module.key !== 'dashboard').forEach((module) => { %>
        <a class="module-card accent-<%= module.accent %>" href="<%= module.href %>">
          <span class="module-icon material-symbols-outlined" aria-hidden="true"><%= module.icon %></span>
          <strong><%= __(module.labelKey) %></strong>
          <p><%= __(module.descriptionKey) %></p>
        </a>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
