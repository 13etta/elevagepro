<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= websiteSettings.heroSubtitle || 'Élevage canin familial, sélection, passion et accompagnement.' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/showcase-domain-forest.css">
</head>
<%
  const siteTitle = breeder.company_name || breeder.name || 'Élevage canin';
  const logoUrl = breeder.logo_url || breeder.logo || '';
  const strengthsList = String(websiteSettings.strengths || '')
    .split(/\r?\n/)
    .map((item) => item.trim())
    .filter(Boolean);
  const heroImage = websiteSettings.heroImageUrl || (websiteSettings.gallery && websiteSettings.gallery[0] && websiteSettings.gallery[0].url) || '';
  const serviceFallbackImages = {
    pension: 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=1200&q=80',
    training: 'https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?auto=format&fit=crop&w=1200&q=80',
    breeding: 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1200&q=80'
  };
  const serviceList = publicServices && publicServices.length ? publicServices : [];
  const dogBreedEntries = Object.entries(dogsByBreed || {});
  const puppyBreedEntries = Object.entries(puppiesByBreed || {});
  const litterBreedEntries = Object.entries(littersByBreed || {});
%>
<body class="domain-forest-site" style="--forest-primary:<%= websiteSettings.primaryColor || '#29422c' %>;--forest-secondary:<%= websiteSettings.secondaryColor || '#bda66f' %>;--forest-bg:<%= websiteSettings.backgroundColor || '#f6f1e8' %>;--forest-text:<%= websiteSettings.textColor || '#24301f' %>;">
  <header class="forest-header">
    <a href="#accueil" class="forest-logo" aria-label="<%= siteTitle %>">
      <% if (logoUrl) { %>
        <img src="<%= logoUrl %>" alt="Logo <%= siteTitle %>">
      <% } else { %>
        <span class="forest-logo-mark">♧</span>
      <% } %>
      <strong><%= siteTitle %></strong>
    </a>
  </header>

  <main>
    <section id="accueil" class="forest-hero" <% if (heroImage) { %>style="background-image:linear-gradient(90deg,rgba(0,0,0,.52),rgba(0,0,0,.18)),url('<%= heroImage %>')"<% } %>>
      <div class="forest-hero-inner">
        <h1><%= websiteSettings.heroTitle || 'Élevage et Dressage de prestige' %></h1>
        <p><%= websiteSettings.heroSubtitle || 'Excellence canine au cœur de la nature.' %></p>
        <div class="forest-actions">
          <% if (websiteSettings.showServices) { %><a href="#services">Nos services</a><% } %>
          <% if (websiteSettings.showContact) { %><a href="#contact" class="secondary">Contactez-nous</a><% } %>
        </div>
      </div>
    </section>

    <section class="forest-newsbar">
      <strong><%= websiteSettings.contactStripTitle || 'La saison est ouverte : contactez l’élevage pour les disponibilités.' %></strong>
      <a href="#contact"><%= websiteSettings.contactStripText || 'En savoir plus' %></a>
    </section>

    <% if (websiteSettings.showServices && serviceList.length) { %>
      <section id="services" class="forest-services">
        <% serviceList.forEach((service, index) => { const image = service.imageUrl || serviceFallbackImages[service.key] || serviceFallbackImages.breeding; %>
          <article class="forest-service <%= index % 2 === 1 ? 'reverse' : '' %>">
            <div class="forest-service-image"><img src="<%= image %>" alt="<%= service.title %>"></div>
            <div class="forest-service-copy">
              <h2><%= service.title %></h2>
              <p><%= service.text %></p>
              <a href="<%= service.anchor || '#contact' %>"><%= service.button || 'Découvrir' %></a>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>

    <% if (websiteSettings.showDogs && dogBreedEntries.length) { %>
      <section id="selection" class="forest-section forest-selection">
        <div class="forest-section-title">
          <span>Sélection</span>
          <h2>Chiens adultes classés par race</h2>
        </div>
        <% dogBreedEntries.forEach(([breed, breedDogs]) => { %>
          <div class="forest-breed-block">
            <h3><%= breed %></h3>
            <div class="forest-animal-grid">
              <% breedDogs.forEach((dog) => { %>
                <article class="forest-animal-card">
                  <% if (dog.photo_url) { %><img src="<%= dog.photo_url %>" alt="<%= dog.name %>"><% } %>
                  <div>
                    <span><%= dog.sex === 'M' ? 'Mâle' : dog.sex === 'F' ? 'Femelle' : 'Chien' %></span>
                    <h4><%= dog.name %></h4>
                    <% if (dog.lof) { %><p>LOF : <%= dog.lof %></p><% } %>
                    <% if (dog.notes) { %><p><%= String(dog.notes).slice(0, 140) %><%= String(dog.notes).length > 140 ? '…' : '' %></p><% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </section>
    <% } %>

    <% if (websiteSettings.showLitters && litterBreedEntries.length) { %>
      <section class="forest-section forest-litters">
        <div class="forest-section-title">
          <span>Portées</span>
          <h2>Portées actuelles par race</h2>
        </div>
        <% litterBreedEntries.forEach(([breed, breedLitters]) => { %>
          <div class="forest-breed-block">
            <h3><%= breed %></h3>
            <div class="forest-litter-grid">
              <% breedLitters.forEach((litter) => { const litterImages = (websiteSettings.litterGallery && websiteSettings.litterGallery[litter.id]) || []; %>
                <article class="forest-litter-card">
                  <% if (litterImages[0]) { %><img src="<%= litterImages[0].url %>" alt="Portée <%= breed %>"><% } %>
                  <div>
                    <h4>Portée de <%= litter.mother_name || 'mère non renseignée' %></h4>
                    <p>Née le <%= formatDate(litter.birth_date) %></p>
                    <p><%= litter.puppies_count_total || litter.puppies_count || litter.nb_puppies || 0 %> chiot(s)</p>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </section>
    <% } %>

    <% if (websiteSettings.showPuppies && puppyBreedEntries.length) { %>
      <section id="chiots" class="forest-section forest-puppies">
        <div class="forest-section-title">
          <span>Disponibilités</span>
          <h2>Chiots disponibles classés par race</h2>
        </div>
        <% puppyBreedEntries.forEach(([breed, breedPuppies]) => { %>
          <div class="forest-breed-block">
            <h3><%= breed %></h3>
            <div class="forest-puppy-grid">
              <% breedPuppies.forEach((puppy) => { const litterImages = (websiteSettings.litterGallery && websiteSettings.litterGallery[puppy.litter_id]) || []; %>
                <article class="forest-puppy-card">
                  <% if (litterImages[0]) { %><img src="<%= litterImages[0].url %>" alt="Chiot <%= breed %>"><% } %>
                  <div>
                    <span><%= puppy.status || 'Disponible' %></span>
                    <h4><%= puppy.name || 'Chiot disponible' %></h4>
                    <p><%= puppy.sex || '-' %> · <%= puppy.color || 'Robe non renseignée' %></p>
                    <% if (puppy.mother_name) { %><p>Mère : <strong><%= puppy.mother_name %></strong></p><% } %>
                    <% if (puppy.sale_price) { %><p class="forest-price"><%= puppy.sale_price %> €</p><% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </section>
    <% } %>

    <% if (websiteSettings.showStrengths && strengthsList.length) { %>
      <section class="forest-strengths">
        <h2><%= websiteSettings.strengthsTitle || 'Pourquoi nous choisir' %></h2>
        <div>
          <% strengthsList.slice(0, 3).forEach((strength, index) => { %>
            <article>
              <span><%= index === 0 ? '◷' : index === 1 ? '◈' : '♧' %></span>
              <strong><%= strength %></strong>
              <p>Une exigence quotidienne au service du chien, de la famille et de la sélection.</p>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (websiteSettings.showGallery && websiteSettings.gallery && websiteSettings.gallery.length) { %>
      <section id="galerie" class="forest-section forest-gallery">
        <div class="forest-section-title">
          <span>Galerie</span>
          <h2>Vie de l’élevage</h2>
        </div>
        <div>
          <% websiteSettings.gallery.slice(0, 12).forEach((image) => { %>
            <img src="<%= image.url %>" alt="Photo de l’élevage">
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (websiteSettings.showContact) { %>
      <section id="contact" class="forest-contact">
        <div class="forest-contact-inner">
          <form class="forest-contact-form">
            <h2>Contact</h2>
            <div class="forest-form-grid">
              <input placeholder="Nom">
              <input placeholder="E-mail">
              <input placeholder="Téléphone">
              <input placeholder="Projet">
            </div>
            <textarea placeholder="Message"></textarea>
            <button type="button">Envoyer le message</button>
          </form>
          <div class="forest-contact-details">
            <% if (breeder.phone) { %><p>☎ <a href="tel:<%= breeder.phone %>"><%= breeder.phone %></a></p><% } %>
            <% if (breeder.email) { %><p>✉ <a href="mailto:<%= breeder.email %>"><%= breeder.email %></a></p><% } %>
            <% if (breeder.address) { %><p>◆ <%= breeder.address %></p><% } %>
            <% if (websiteSettings.openingHours) { %><p>◷ <%= websiteSettings.openingHours %></p><% } %>
            <% if (websiteSettings.instagram) { %><p>Instagram : <%= websiteSettings.instagram %></p><% } %>
            <% if (websiteSettings.facebook) { %><p>Facebook : <%= websiteSettings.facebook %></p><% } %>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="forest-footer">
    <strong><%= siteTitle %></strong>
    <span>© <%= new Date().getFullYear() %> · Propulsé par ElevagePro</span>
  </footer>
</body>
</html>