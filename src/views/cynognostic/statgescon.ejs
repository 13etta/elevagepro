<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="header-actions" style="display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; margin-bottom:1rem;">
    <div>
      <p style="text-transform:uppercase; letter-spacing:.12em; color:#7c3aed; font-weight:800; margin:0 0 .35rem;">Source externe</p>
      <h1 style="margin:0;">Recherche StatGescon</h1>
      <p style="color:#64748b; max-width:900px; line-height:1.6;">StatGescon est traité comme une source tabulaire : recherche par nom de chien, affixe, conducteur, discipline ou qualificatif dans les tableaux statistiques disponibles.</p>
    </div>
    <a href="/cynognostic" class="btn btn-secondary">Retour CYNOGNOSTIC</a>
  </div>

  <section class="card" style="margin-bottom:1.5rem;">
    <h2>Rechercher dans les tableaux</h2>
    <form action="/cynognostic/statgescon/search" method="POST" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-field">
        <label>Terme recherché</label>
        <input type="text" name="dog_name" value="<%= dogName || '' %>" placeholder="NOX DE CAZAOUS, FORETS CORREZIENNES, conducteur..." required>
      </div>
      <div class="form-field">
        <label>URL StatGescon</label>
        <input type="url" name="base_url" value="<%= baseUrl || 'https://statgescon.onrender.com' %>" required>
      </div>
      <div style="display:flex; align-items:flex-end;">
        <button type="submit" class="btn btn-primary">Interroger StatGescon</button>
      </div>
    </form>
  </section>

  <% if (result) { %>
    <% const matchedCount = result.matchedRows ? result.matchedRows.length : 0; %>
    <% const records = result.matchedRecords || []; %>
    <% const hasUsefulMatch = matchedCount > 0 || !!result.text; %>
    <section class="card" style="margin-bottom:1.5rem; border-left:5px solid <%= hasUsefulMatch ? '#16a34a' : '#f59e0b' %>;">
      <h2>Résultat</h2>
      <p><strong>Statut :</strong> <%= hasUsefulMatch ? 'Correspondance trouvée ou contenu récupéré' : 'Page récupérée, mais aucune ligne correspondante détectée' %></p>
      <p><strong>Terme recherché :</strong> <%= result.query || result.dogName || dogName || '-' %></p>
      <p><strong>Base URL :</strong> <%= result.baseUrl %></p>
      <p><strong>Lignes CSV détectées :</strong> <%= result.totalRowsDetected || 0 %></p>
      <p><strong>Lignes correspondantes :</strong> <%= matchedCount %></p>
      <% if (result.url) { %><p><strong>Première source retenue :</strong> <a href="<%= result.url %>" target="_blank" rel="noopener noreferrer"><%= result.url %></a></p><% } %>
      <% if (result.message) { %><p><%= result.message %></p><% } %>
    </section>

    <% if (records.length) { %>
      <section class="card" style="margin-bottom:1.5rem;">
        <h2>Résultats structurés</h2>
        <p style="color:#64748b;">Lecture colonne par colonne des CSV StatGescon. Ces données sont prêtes à être recoupées avec LOF Select et le pedigree.</p>
        <% records.forEach((record, index) => { %>
          <article style="border:1px solid rgba(148,163,184,.35); border-radius:14px; padding:1rem; margin:1rem 0;">
            <div style="display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; margin-bottom:.75rem;">
              <div>
                <strong>#<%= index + 1 %> — <%= record.source %></strong>
              </div>
            </div>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:.75rem;">
              <% record.pairs.forEach((pair) => { %>
                <div style="background:rgba(148,163,184,.08); border-radius:10px; padding:.65rem;">
                  <small style="display:block; color:#64748b; font-weight:700;"><%= pair.key %></small>
                  <span><%= pair.value || '-' %></span>
                </div>
              <% }) %>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>

    <section class="card" style="margin-bottom:1.5rem;">
      <h2>Tentatives effectuées</h2>
      <% if (result.attempts && result.attempts.length) { %>
        <div class="table-responsive">
          <table class="table" style="width:100%;">
            <thead><tr><th>URL</th><th>Statut</th><th>Type</th><th>Erreur</th></tr></thead>
            <tbody>
              <% result.attempts.forEach((attempt) => { %>
                <tr>
                  <td><code><%= attempt.url %></code></td>
                  <td><%= attempt.status %></td>
                  <td><%= attempt.contentType || '-' %></td>
                  <td><%= attempt.error || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><p>Aucune tentative enregistrée.</p><% } %>
    </section>

    <% if (result.text) { %>
      <section class="card" style="margin-bottom:1.5rem;">
        <h2>Export texte pour analyse</h2>
        <p style="color:#64748b;">Copie ce bloc dans une analyse CYNOGNOSTIC pour enrichir le rapport pedigree / travail / transmission.</p>
        <pre style="white-space:pre-wrap; max-height:520px; overflow:auto;"><%= result.text %></pre>
      </section>
    <% } %>

    <% if (result.rawPreview && !result.text) { %>
      <section class="card">
        <h2>Aperçu brut de la page</h2>
        <p style="color:#64748b;">La page répond, mais aucun résultat exploitable n'a été trouvé.</p>
        <pre style="white-space:pre-wrap; max-height:520px; overflow:auto;"><%= result.rawPreview %></pre>
      </section>
    <% } %>
  <% } %>
</main>

<%- include('../partials/foot') %>
