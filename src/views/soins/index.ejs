<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%
  const editing = editingSoin || null;
  const formAction = editing ? `/soins/${editing.id}/edit` : '/soins/new';
  const selectedAnimal = editing
    ? (editing.puppy_id ? `puppy|${editing.puppy_id}` : (editing.dog_id ? `dog|${editing.dog_id}` : ''))
    : '';
  const dateInputValue = (value) => {
    if (!value) return '';
    const date = value instanceof Date ? value : new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toISOString().slice(0, 10);
  };
%>
<main class="container">
  <section class="page-hero">
    <div>
      <p class="eyebrow">Registre sanitaire</p>
      <h1>Soins & santé</h1>
      <p>Enregistrez, corrigez et suivez les vaccins, vermifuges, antiparasitaires, consultations et actes sanitaires pour les chiens adultes comme pour les chiots.</p>
    </div>
  </section>

  <section class="form-block card" style="margin-bottom: 1.5rem;">
    <div style="display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; flex-wrap:wrap;">
      <div>
        <p class="eyebrow">Impression et contrôle</p>
        <h3 style="margin-top:.25rem;">Générer le registre sanitaire PDF</h3>
        <p class="muted" style="max-width:760px;">Le document reprend les vaccinations, vermifuges, antiparasitaires, visites vétérinaires et autres actes. Les observations sont imprimées intégralement sur plusieurs lignes et plusieurs pages si nécessaire.</p>
      </div>
      <a href="/soins/registre-sanitaire.pdf?scope=dogs" target="_blank" class="btn btn-primary">
        <span class="material-symbols-outlined" aria-hidden="true">print</span>
        Imprimer le récapitulatif de tous les chiens
      </a>
    </div>

    <p class="muted" style="margin:.75rem 0 0;">Ce bouton génère en une seule fois un PDF regroupant tous les chiens actifs, avec une section distincte par chien. Les chiots et les soins généraux ne sont pas inclus dans ce récapitulatif.</p>

    <form action="/soins/registre-sanitaire.pdf" method="GET" target="_blank">
      <div class="form-grid" style="align-items:end; margin-top:1rem;">
        <div class="form-group">
          <label for="pdf_animal">Animal</label>
          <select id="pdf_animal" name="animal">
            <option value="">Tous les animaux</option>
            <optgroup label="Chiens adultes actifs">
              <% dogs.forEach(d => { %>
                <option value="dog|<%= d.id %>"><%= d.name %><% if (d.chip_number) { %> — <%= d.chip_number %><% } %></option>
              <% }) %>
            </optgroup>
            <optgroup label="Chiots">
              <% puppies.forEach(p => { %>
                <option value="puppy|<%= p.id %>"><%= p.name || 'Chiot sans nom' %><% if (p.chip_number) { %> — <%= p.chip_number %><% } %></option>
              <% }) %>
            </optgroup>
          </select>
        </div>

        <div class="form-group">
          <label for="pdf_type">Catégorie</label>
          <select id="pdf_type" name="type">
            <option value="">Toutes les catégories</option>
            <option value="vaccin">Vaccinations</option>
            <option value="vermifuge">Vermifuges</option>
            <option value="antiparasitaire">Antiparasitaires</option>
            <option value="veterinaire">Visites vétérinaires</option>
            <option value="desinfection">Désinfection</option>
            <option value="autre">Autres actes</option>
          </select>
        </div>

        <div class="form-group">
          <label for="pdf_from">Du</label>
          <input type="date" id="pdf_from" name="from">
        </div>

        <div class="form-group">
          <label for="pdf_to">Au</label>
          <input type="date" id="pdf_to" name="to">
        </div>
      </div>

      <label style="display:flex; gap:.55rem; align-items:center; margin:.75rem 0 1rem;">
        <input type="checkbox" name="include_archived" value="1" style="width:auto;">
        Inclure les chiens sortis présents dans les archives
      </label>

      <button type="submit" class="btn btn-primary">
        <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
        Générer le registre sanitaire PDF
      </button>
    </form>
  </section>

  <div class="form-grid" style="align-items: start;">
      <section class="form-block card">
        <h3><%= editing ? 'Rectifier une saisie sanitaire' : 'Enregistrer un nouveau soin' %></h3>
        <% if (editing) { %>
          <p class="muted">Mode correction : la modification remettra aussi à jour le rappel associé lorsque la prochaine échéance est renseignée.</p>
        <% } %>
        <form action="<%= formAction %>" method="POST">
            <% if (typeof csrfToken !== 'undefined') { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="form-group">
                <label for="animal_selection">Animal concerné</label>
                <select id="animal_selection" name="animal_selection">
                    <option value="" <%= selectedAnimal === '' ? 'selected' : '' %>>-- Soin d'élevage / Général --</option>

                    <optgroup label="Chiens adultes">
                        <% dogs.forEach(d => { %>
                            <% const value = `dog|${d.id}`; %>
                            <option value="<%= value %>" <%= selectedAnimal === value ? 'selected' : '' %>>
                                <%= d.name %>
                                <% if (d.chip_number) { %> — <%= d.chip_number %><% } %>
                            </option>
                        <% }) %>
                    </optgroup>

                    <optgroup label="Chiots">
                        <% puppies.forEach(p => { %>
                            <% const value = `puppy|${p.id}`; %>
                            <option value="<%= value %>" <%= selectedAnimal === value ? 'selected' : '' %>>
                                <%= p.name || 'Chiot sans nom' %>
                                <% if (p.mother_name) { %> — portée de <%= p.mother_name %><% } %>
                                <% if (p.chip_number) { %> — <%= p.chip_number %><% } %>
                            </option>
                        <% }) %>
                    </optgroup>
                </select>
            </div>

            <div class="form-group">
                <label for="type">Catégorie *</label>
                <select id="type" name="type" required>
                    <% ['vaccin', 'vermifuge', 'antiparasitaire', 'veterinaire', 'desinfection', 'autre'].forEach((type) => { %>
                      <option value="<%= type %>" <%= (editing?.type || 'vaccin') === type ? 'selected' : '' %>><%= type %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="label">Libellé du soin * (ex: CHPPI2L, Milbemax...)</label>
                <input type="text" id="label" name="label" value="<%= editing?.label || '' %>" required>
            </div>

            <div class="form-group">
                <label for="event_date">Date de l'acte *</label>
                <input type="date" id="event_date" name="event_date" value="<%= dateInputValue(editing?.event_date) %>" required>
            </div>

            <div class="form-group">
                <label for="next_due">Prochaine échéance (génère ou corrige un rappel automatique)</label>
                <input type="date" id="next_due" name="next_due" value="<%= dateInputValue(editing?.next_due) %>">
            </div>

            <div class="form-group">
                <label for="notes">Observations éventuelles</label>
                <textarea id="notes" name="notes" rows="4"><%= editing?.notes || '' %></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
              <%= editing ? 'Enregistrer la correction' : 'Ajouter au registre' %>
            </button>

            <% if (editing) { %>
              <a href="/soins" class="btn btn-secondary" style="width: 100%; margin-top: .75rem;">Annuler la correction</a>
            <% } %>
        </form>
      </section>

      <section class="table-block">
        <h3>Historique sanitaire</h3>
        <table>
          <thead>
            <tr>
                <th>Date</th>
                <th>Animal</th>
                <th>Catégorie</th>
                <th>Acte</th>
                <th>Prochaine échéance</th>
                <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (soins.length === 0) { %>
                <tr><td colspan="6">Aucun soin enregistré.</td></tr>
            <% } %>
            <% soins.forEach((soin) => { %>
              <tr>
                <td><strong><%= formatDate(soin.event_date) %></strong></td>
                <td><%= soin.animal_name || 'Général' %></td>
                <td><%= soin.animal_category || 'Général' %></td>
                <td>
                    <span class="badge"><%= soin.type %></span>
                    <%= soin.label %>
                    <% if (soin.notes) { %><br><small style="white-space:pre-wrap;"><%= soin.notes %></small><% } %>
                </td>
                <td>
                    <%= soin.next_due ? formatDate(soin.next_due) : '-' %>
                </td>
                <td style="white-space: nowrap;">
                  <a href="/soins/<%= soin.id %>/edit" class="btn btn-secondary btn-sm">Rectifier</a>
                  <form action="/soins/<%= soin.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Supprimer définitivement cette saisie de soin ?');">
                    <% if (typeof csrfToken !== 'undefined') { %>
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% } %>
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
  </div>
</main>
<%- include('../partials/foot') %>