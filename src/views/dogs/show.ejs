<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container dog-profile-page">
  <div class="dog-profile-toolbar">
    <a class="dog-profile-back" href="/dogs"><span class="material-symbols-outlined">arrow_back</span> Dog profile</a>
    <div class="dog-profile-actions">
      <a class="btn btn-secondary" href="/dogs"><span class="material-symbols-outlined">arrow_back</span> Retour</a>
      <a class="btn btn-primary" href="/dogs/<%= dog.id %>/edit"><span class="material-symbols-outlined">edit</span> Modifier</a>
    </div>
  </div>

  <section class="dog-profile-hero <%= dog.photo_url ? 'has-photo' : 'no-photo' %>">
    <% if (dog.photo_url) { %>
      <img class="dog-profile-hero-img" src="<%= dog.photo_url %>" alt="Photo de <%= dog.name %>">
    <% } %>
    <div class="dog-profile-hero-overlay"></div>
    <div class="dog-profile-hero-content">
      <div>
        <h1><%= dog.name %></h1>
        <p><%= dog.breed || 'Race non renseignée' %> — <%= dog.sex === 'M' ? 'Mâle' : dog.sex === 'F' ? 'Femelle' : '-' %></p>
      </div>
      <dl class="dog-profile-identity">
        <div><dt>Date de naissance</dt><dd><%= dog.birth_date ? formatDate(dog.birth_date) : '-' %></dd></div>
        <div><dt>ID</dt><dd><%= dog.chip_number || dog.id_scc || '-' %></dd></div>
        <div><dt>LOF</dt><dd><%= dog.lof || dog.pedigree_number || '-' %></dd></div>
      </dl>
      <span class="dog-profile-status"><%= dog.status || 'actif' %></span>
    </div>
    <a class="dog-profile-hero-edit" href="/dogs/<%= dog.id %>/edit"><span class="material-symbols-outlined">edit</span> Modifier</a>
    <% if (!dog.photo_url) { %>
      <div class="dog-profile-placeholder"><span><%= dogInitials(dog.name) %></span></div>
    <% } %>
  </section>

  <section class="dog-profile-grid dog-profile-grid-main">
    <article class="dog-profile-card">
      <div class="dog-profile-card-head">
        <h2>Immersion & Suivi</h2>
      </div>
      <div class="dog-profile-progress-row">
        <strong>Progress</strong>
        <span><%= completeness.percent %>%</span>
      </div>
      <div class="dog-profile-progress"><span style="width: <%= completeness.percent %>%;"></span></div>
      <% if (completeness.missing.length) { %>
        <p>À compléter : <%= completeness.missing.join(', ') %>.</p>
      <% } else { %>
        <p>Fiche bien documentée pour le suivi interne et les usages commerciaux.</p>
      <% } %>
    </article>

    <article class="dog-profile-card">
      <div class="dog-profile-card-head">
        <h2>Observations</h2>
      </div>
      <p><%= dog.notes || 'Aucune observation renseignée. Ajoutez ici les éléments utiles : acquisition, caractère, aptitudes, comportement, recommandations ou restrictions.' %></p>
    </article>

    <article class="dog-profile-card dog-profile-health-card">
      <div class="dog-profile-card-head">
        <h2>Santé</h2>
      </div>
      <% if (!soins.length) { %>
        <p class="dog-profile-empty">Aucun soin enregistré.</p>
      <% } else { %>
        <div class="dog-profile-mini-table">
          <div class="dog-profile-mini-row dog-profile-mini-head"><span>Date</span><span>Acte</span></div>
          <% soins.slice(0, 4).forEach((soin) => { %>
            <div class="dog-profile-mini-row">
              <span><%= formatDate(soin.event_date) %></span>
              <span><%= soin.label %><small><%= soin.next_due ? 'Échéance: ' + formatDate(soin.next_due) : '' %></small></span>
            </div>
          <% }) %>
        </div>
      <% } %>
      <a class="dog-profile-card-button" href="/soins">Ajouter un soin</a>
    </article>

    <article class="dog-profile-card dog-profile-repro-card">
      <div class="dog-profile-card-head">
        <h2>Reproduction</h2>
      </div>
      <h3>Portées liées</h3>
      <% if (!litters.length) { %>
        <div class="dog-profile-mini-table muted-table">
          <div class="dog-profile-mini-row dog-profile-mini-head"><span>Portée</span><span>Issus</span></div>
          <p class="dog-profile-empty centered">Non portée actuellement</p>
        </div>
      <% } else { %>
        <div class="dog-profile-mini-table">
          <div class="dog-profile-mini-row dog-profile-mini-head"><span>Date</span><span>Chiots</span></div>
          <% litters.slice(0, 3).forEach((litter) => { %>
            <div class="dog-profile-mini-row"><span><%= formatDate(litter.birth_date) %></span><span><%= litter.puppies_count_total || '-' %></span></div>
          <% }) %>
        </div>
      <% } %>

      <h3>Chiots issus des portées</h3>
      <% if (!puppies.length) { %>
        <div class="dog-profile-mini-table muted-table">
          <div class="dog-profile-mini-row dog-profile-mini-head"><span>Portée</span><span>Statut</span></div>
          <p class="dog-profile-empty centered">Non portée actuellement</p>
        </div>
      <% } else { %>
        <div class="dog-profile-mini-table">
          <div class="dog-profile-mini-row dog-profile-mini-head"><span>Nom</span><span>Statut</span></div>
          <% puppies.slice(0, 4).forEach((puppy) => { %>
            <a class="dog-profile-mini-row link-row" href="/puppies/<%= puppy.id %>"><span><%= puppy.name || 'Chiot sans nom' %></span><span><%= puppy.status || '-' %></span></a>
          <% }) %>
        </div>
      <% } %>
    </article>
  </section>

  <section class="dog-profile-grid dog-profile-grid-secondary">
    <article class="dog-profile-card">
      <div class="dog-profile-card-head">
        <span>Identité</span>
        <h2>Informations générales</h2>
      </div>
      <dl class="dog-profile-info-list">
        <div><dt>Nom</dt><dd><%= dog.name %></dd></div>
        <div><dt>Race</dt><dd><%= dog.breed || '-' %></dd></div>
        <div><dt>Sexe</dt><dd><%= dog.sex === 'M' ? 'Mâle' : dog.sex === 'F' ? 'Femelle' : '-' %></dd></div>
        <div><dt>N° puce</dt><dd><%= dog.chip_number || '-' %></dd></div>
        <div><dt>ID SCC</dt><dd><%= dog.id_scc || '-' %></dd></div>
        <div><dt>Père</dt><dd><%= dog.father_name || dog.father_name_external || '-' %></dd></div>
        <div><dt>Mère</dt><dd><%= dog.mother_name || dog.mother_name_external || '-' %></dd></div>
      </dl>
    </article>

    <article class="dog-profile-card">
      <div class="dog-profile-card-head">
        <span>Prioritaire</span>
        <h2>Rappels à venir</h2>
      </div>
      <% if (!reminders.length) { %>
        <p class="dog-profile-empty">Aucun rappel actif.</p>
      <% } else { %>
        <div class="dog-profile-reminders">
          <% reminders.slice(0, 6).forEach((reminder) => { %>
            <a href="/reminders" class="dog-profile-reminder">
              <span class="material-symbols-outlined">notifications_active</span>
              <strong><%= reminder.title %></strong>
              <small><%= formatDate(reminder.due_date) %></small>
            </a>
          <% }) %>
        </div>
      <% } %>
    </article>
  </section>
</main>

<%- include('../partials/foot') %>