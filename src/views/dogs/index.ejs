<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main-content" tabindex="-1" class="container dogs-stitch">
  <section class="page-hero dogs-titlebar">
    <div>
      <p class="eyebrow">VOTRE CHEPTEL</p>
      <h1>Vos chiens.</h1>
      <p>Une histoire, une lignée, un suivi. Retrouvez chaque chien de votre élevage.</p>
    </div>
    <a href="/dogs/new" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Ajouter un chien</a>
  </section>

  <% if (typeof query !== 'undefined' && query.sortie === 'ok') { %>
    <div class="alert alert-success">Chien sorti du cheptel et inscrit au registre entrées/sorties.</div>
  <% } %>

  <section class="dogs-filter-panel" aria-label="Filtres chiens">
    <form method="get" action="/dogs" class="dogs-filter-form">
      <div class="form-group">
        <label>Recherche rapide</label>
        <input type="search" name="q" placeholder="Puce, LOF, Nom..." aria-label="Recherche rapide" value="<%= filters?.q || '' %>">
      </div>
      <div class="form-group">
        <label>Sexe</label>
        <select name="sex" aria-label="Filtrer par sexe">
          <option value="">Tous les sexes</option>
          <option value="M" <%= filters?.sex === 'M' ? 'selected' : '' %>>Mâle</option>
          <option value="F" <%= filters?.sex === 'F' ? 'selected' : '' %>>Femelle</option>
        </select>
      </div>
      <div class="form-group">
        <label>Race</label>
        <select name="breed" aria-label="Filtrer par race">
          <option value="">Toutes les races</option>
          <% (typeof breedOptions !== 'undefined' ? breedOptions : [...new Set(dogs.map((dog) => dog.breed).filter(Boolean))]).forEach((breed) => { %>
            <option value="<%= breed %>" <%= filters?.breed === breed ? 'selected' : '' %>><%= breed %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Statut</label>
        <select name="status" aria-label="Filtrer par statut">
          <option value="active" <%= !filters?.status || filters?.status === 'active' ? 'selected' : '' %>>Chiens actifs</option>
          <option value="sorti" <%= filters?.status === 'sorti' ? 'selected' : '' %>>Chiens sortis</option>
          <option value="all" <%= filters?.status === 'all' ? 'selected' : '' %>>Tous les statuts</option>
        </select>
      </div>
      <button class="btn btn-secondary" type="submit"><span class="material-symbols-outlined">filter_list</span> Rechercher</button>
      <a class="filter-reset" href="/dogs">Réinitialiser</a>
    </form>
  </section>

<div class="collection-tools"><div><h2>Mes chiens</h2><p class="muted"><%= dogs.length %> résultat(s) selon vos filtres</p></div><div class="view-switch" data-view-switch hidden><button type="button" data-dog-view="cards" aria-pressed="true">Cartes</button><button type="button" data-dog-view="table" aria-pressed="false">Tableau</button></div></div><section class="animal-grid" data-dog-cards><% dogs.forEach((dog) => { %><article class="animal-card"><a href="/dogs/<%= dog.id %>" class="animal-photo"><% if(dog.photo_url) { %><img src="<%= dog.photo_url %>" alt="<%= dog.name %>" loading="lazy" width="400" height="260"><% } else { %><span class="material-symbols-outlined" aria-hidden="true">pets</span><% } %></a><div class="animal-card-body"><span class="animal-status"><%= dog.status || 'actif' %></span><h3><a href="/dogs/<%= dog.id %>"><%= dog.name %></a></h3><p><%= dog.breed || 'Race non renseignée' %></p><dl><div><dt>Sexe</dt><dd><%= dog.sex === 'M' ? 'Mâle' : dog.sex === 'F' ? 'Femelle' : 'Non renseigné' %></dd></div><div><dt>Naissance</dt><dd><%= dog.birth_date ? formatDate(dog.birth_date) : 'Non renseignée' %></dd></div></dl><a class="btn btn-secondary" href="/dogs/<%= dog.id %>">Ouvrir la fiche →</a></div></article><% }) %><% if(!dogs.length) { %><p>Aucun chien ne correspond aux filtres. <a href="/dogs">Réinitialiser la recherche</a></p><% } %></section>
  <section class="table-block dogs-table-card" data-dog-table>
    <div class="collection-heading"><h2>Le cheptel</h2><span><%= dogs.length %> résultat<%= dogs.length > 1 ? 's' : '' %> affiché<%= dogs.length > 1 ? 's' : '' %></span></div>
    <table>
      <thead>
        <tr>
          <th>Chien</th>
          <th>Race</th>
          <th>Sexe · naissance</th>
          <th>Statut</th>
          <th>Santé</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (dogs.length === 0) { %>
          <tr><td colspan="6">Aucun chien ne correspond à cette recherche. Modifiez vos filtres ou ajoutez votre premier chien.</td></tr>
        <% } %>
        <% dogs.forEach((dog) => { %>
          <% const dogStatus = String(dog.status || 'actif').toLowerCase(); %>
          <tr>
            <td>
              <a class="dog-row-link" href="/dogs/<%= dog.id %>">
                <span class="dog-avatar small">
                  <% if (dog.photo_url) { %>
                    <img src="<%= dog.photo_url %>" alt="Photo de <%= dog.name %>">
                  <% } else { %>
                    <span class="material-symbols-outlined">pets</span>
                  <% } %>
                </span>
                <span>
                  <strong><%= dog.name %></strong>
                  <small><%= dog.chip_number ? 'Puce: ' + dog.chip_number : (dog.lof ? 'LOF: ' + dog.lof : 'Identification non renseignée') %></small>
                </span>
              </a>
            </td>
            <td><%= dog.breed || '-' %></td>
            <td>
              <span><%= dog.sex === 'M' ? '♂' : '♀' %></span>
              <%= dog.birth_date ? formatDate(dog.birth_date) : 'Âge non renseigné' %>
            </td>
            <td><span class="badge <%= dogStatus %>"><%= dogStatus === 'sorti' ? 'sorti' : (dog.status || 'actif') %></span></td>
            <td>
              <span class="muted">Suivi médical</span><br>
              <small>Voir fiche</small>
            </td>
            <td class="table-actions">
              <a href="/dogs/<%= dog.id %>" class="btn btn-secondary btn-sm">Voir fiche</a>
              <a href="/dogs/<%= dog.id %>/edit" class="btn btn-secondary btn-sm">Modifier</a>
              <% if (dogStatus !== 'sorti') { %>
                <a href="/dogs/<%= dog.id %>/delete" class="btn btn-danger btn-sm">Sortir</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>

<%- include('../partials/foot') %>
