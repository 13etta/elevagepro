<a class="skip-link" href="#app-content">Aller au contenu</a>
<div class="mobile-appbar">
  <a class="brand mobile-brand" href="/dashboard" aria-label="ElevagePro">
    <img class="application-logo" src="/images/elevagepro-logo.png" alt="" width="52" height="52">
    <span>
      <strong>ElevagePro</strong>
      <small>L’espace des éleveurs</small>
    </span>
  </a>
  <nav class="horizon-navigation" aria-label="Espaces principaux"><a href="/dashboard" <%- currentPath === '/dashboard' ? 'aria-current="page"' : '' %>>Aujourd’hui</a><a href="/dogs" <%- currentPath.startsWith('/dogs') ? 'aria-current="page"' : '' %>>Le cheptel</a><a href="/reproduction" <%- currentPath.startsWith('/reproduction') ? 'aria-current="page"' : '' %>>Reproduction</a><a href="/calendar" <%- currentPath.startsWith('/calendar') ? 'aria-current="page"' : '' %>>Agenda</a></nav>
  <button class="nav-toggle" type="button" data-nav-toggle aria-controls="main-sidebar" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
    <span class="sr-only">Ouvrir le menu</span>
  </button>
</div>

<div class="sidebar-backdrop" data-nav-close></div>

<aside class="sidebar" id="main-sidebar">
  <a class="brand" href="/dashboard" aria-label="ElevagePro">
    <img class="application-logo" src="/images/elevagepro-logo.png" alt="" width="64" height="64">
    <span class="brand-text">
      <strong>ElevagePro</strong>
      <small>L’espace des éleveurs</small>
    </span>
  </a>

  <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-label="Réduire le menu">
    <span></span>
  </button>

  <nav class="nav-sections" aria-label="Navigation principale">
    <% moduleGroups.forEach((group) => { %>
      <% const groupModules = modules.filter((module) => module.group === group.key); %>
      <% if (groupModules.length) { %>
        <section class="nav-group">
          <p class="nav-group-title"><%= __(group.labelKey) %></p>
          <% groupModules.forEach((module) => { %>
            <a class="nav-link <%= currentPath === module.href || currentPath.startsWith(module.href + '/') ? 'active' : '' %>" href="<%= module.href %>" title="<%= __(module.labelKey) %>" <%- currentPath === module.href || currentPath.startsWith(module.href + '/') ? 'aria-current="page"' : '' %>>
              <span class="nav-icon material-symbols-outlined"><%= module.icon %></span>
              <span class="nav-label"><%= __(module.labelKey) %></span>
            </a>
          <% }) %>
        </section>
      <% } %>
    <% }) %>
  </nav>

  <div class="sidebar-footer">
    <% if (user && ['owner', 'admin'].includes(user.role)) { %><a class="settings-chip" href="/billing"><span class="material-symbols-outlined">credit_card</span>Abonnement</a><% } %>
    <a class="settings-chip" href="/settings"><span class="material-symbols-outlined">settings</span><%= __('nav.settings') %></a>
    <form method="POST" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="logout-link" type="submit"><span class="material-symbols-outlined">logout</span><%= __('auth.logout') %></button>
    </form>
  </div>
</aside>

<div class="app-shell" id="app-content" tabindex="-1">
  <header class="topbar">
    <button type="button" class="command-trigger btn btn-secondary" data-command-open>Navigation rapide <kbd>Ctrl / ⌘ K</kbd></button>
    <form class="topbar-search" action="/dogs" method="GET" role="search">
      <span class="material-symbols-outlined">search</span>
      <input type="search" name="q" placeholder="Rechercher un chien…" aria-label="Recherche">
    </form>

    <div class="topbar-actions">


      <span class="topbar-divider"></span>
      <a class="icon-action" href="/calendar" aria-label="Calendrier"><span class="material-symbols-outlined">calendar_month</span></a>
      <a class="icon-action" href="/reminders" aria-label="Rappels"><span class="material-symbols-outlined">notifications</span></a>

      <a class="user-avatar" href="/settings" aria-label="Profil"><span><%= user && user.full_name ? user.full_name.charAt(0).toUpperCase() : 'E' %></span></a>
    </div>
  </header>

  <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
    <div class="flash-message flash-<%= flash.type || 'info' %>" role="status" aria-live="polite">
      <span class="material-symbols-outlined"><%= flash.type === 'error' ? 'error' : flash.type === 'success' ? 'check_circle' : 'info' %></span>
      <span><%= flash.message %></span>
    </div>
  <% } %>
  <% if (typeof accountAccess !== 'undefined' && !accountAccess) { %>
    <div class="flash-message flash-info" role="status"><span>Votre élevage est consultable en lecture seule. Un abonnement actif permet d’enregistrer des modifications.</span><% if (user && ['owner','admin'].includes(user.role)) { %> <a href="/billing">Gérer l’abonnement</a><% } %></div>
  <% } %>
