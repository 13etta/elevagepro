<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container">
    <div class="header-actions">
        <div>
            <p class="eyebrow">Conformité DDPP</p>
            <h1>Registre Sanitaire</h1>
        </div>
        <div>
            <a href="/breeder" class="btn btn-secondary">Retour au tableau de bord</a>
            <button onclick="window.print()" class="btn btn-primary">Imprimer le registre</button>
        </div>
    </div>

    <section class="card" style="margin-top: 2rem;">
        <h2 style="border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
            Plan de nettoyage (Marche en avant)
        </h2>
        
        <form action="/breeder/register/health/cleaning" method="POST" class="form-block no-print" style="background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
            <div class="form-grid">
                <div class="form-group">
                    <label>Date du nettoyage *</label>
                    <input type="date" name="cleaning_date" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                
                <div class="form-group">
                    <label>Zone traitée * (Ordre conseillé : Sain vers Sale)</label>
                    <select name="zone_type" required>
                        <% 
                            // Tri dynamique des infrastructures basé sur les données de l'éleveur
                            const zonesSaines = infrastructures.filter(i => ['nurserie'].includes(i.type));
                            const zonesStandards = infrastructures.filter(i => ['box', 'parc', 'autre'].includes(i.type));
                            const zonesRisques = infrastructures.filter(i => ['infirmerie', 'quarantaine'].includes(i.type));
                        %>

                        <% if (infrastructures.length === 0) { %>
                            <option value="" disabled selected>Veuillez d'abord déclarer vos infrastructures</option>
                        <% } else { %>
                            
                            <% if (zonesSaines.length > 0) { %>
                                <optgroup label="Zones Saines (À faire en premier)">
                                    <% zonesSaines.forEach(infra => { %>
                                        <option value="<%= infra.name %>"><%= infra.name %></option>
                                    <% }) %>
                                </optgroup>
                            <% } %>

                            <% if (zonesStandards.length > 0) { %>
                                <optgroup label="Zones Standards">
                                    <% zonesStandards.forEach(infra => { %>
                                        <option value="<%= infra.name %>"><%= infra.name %></option>
                                    <% }) %>
                                </optgroup>
                            <% } %>

                            <% if (zonesRisques.length > 0) { %>
                                <optgroup label="Zones à Risque (À faire en dernier)">
                                    <% zonesRisques.forEach(infra => { %>
                                        <option value="<%= infra.name %>"><%= infra.name %></option>
                                    <% }) %>
                                </optgroup>
                            <% } %>

                        <% } %>
                    </select>
                    <% if (infrastructures.length === 0) { %>
                        <small style="color: #dc3545;">Configurez vos bâtiments dans l'onglet Infrastructures.</small>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Protocole utilisé *</label>
                    <select name="protocol_used" required>
                        <option value="Nettoyage Quotidien (Détergent)">Nettoyage Quotidien (Détergent)</option>
                        <option value="Désinfection Profonde (Virucide)">Désinfection Profonde (Virucide)</option>
                        <option value="Vide Sanitaire">Vide Sanitaire</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Réalisé par *</label>
                    <input type="text" name="done_by" required placeholder="Nom de l'intervenant">
                </div>
            </div>

            <div class="form-group" style="margin-top: 1rem;">
                <label>Description / Observations par structure</label>
                <textarea name="notes" rows="3" placeholder="Ex : Chenil 1 nettoyé intégralement. Déjections importantes côté gauche. Abreuvoir rincé. Désinfection complémentaire réalisée sur la dalle."></textarea>
                <small>Tracez ici l'état constaté, les anomalies, les actions correctives ou les précisions utiles pour cette zone.</small>
            </div>

            <button type="submit" class="btn btn-secondary" style="margin-top: 1rem;" <%= infrastructures.length === 0 ? 'disabled' : '' %>>Ajouter au journal de nettoyage</button>
        </form>

        <div style="overflow-x: auto;">
            <table class="data-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #ddd;">
                        <th style="padding: 1rem;">Date</th>
                        <th style="padding: 1rem;">Zone</th>
                        <th style="padding: 1rem;">Protocole</th>
                        <th style="padding: 1rem;">Intervenant</th>
                        <th style="padding: 1rem;">Description / Observations</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cleaningLogs.length === 0) { %>
                        <tr><td colspan="5" style="padding: 1rem; text-align: center;">Aucun nettoyage tracé.</td></tr>
                    <% } else { %>
                        <% cleaningLogs.forEach(log => { %>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 1rem;"><strong><%= new Date(log.cleaning_date).toLocaleDateString('fr-FR') %></strong></td>
                                <td style="padding: 1rem;"><%= log.zone_type %></td>
                                <td style="padding: 1rem;"><%= log.protocol_used %></td>
                                <td style="padding: 1rem;"><%= log.done_by %></td>
                                <td style="padding: 1rem; max-width: 360px;"><%= log.notes || '-' %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="card" style="margin-top: 2rem;">
        <h2 style="border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
            Interventions & Événements Sanitaires
        </h2>

        <form action="/breeder/register/health/record" method="POST" class="form-block no-print" style="background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
            <div class="form-grid">
                <div class="form-group">
                    <label>Date de l'événement *</label>
                    <input type="date" name="event_date" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                
                <div class="form-group">
                    <label>Type d'événement *</label>
                    <select name="event_type" required>
                        <option value="Visite Sanitaire (Annuelle)">Visite Sanitaire (Annuelle)</option>
                        <option value="Traitement Préventif">Traitement Préventif (Vermifuge/Anti-puces global)</option>
                        <option value="Déclaration Maladie">Déclaration Maladie Contagieuse</option>
                        <option value="Autre Intervention">Autre Intervention Vétérinaire</option>
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-top: 1rem;">
                <label>Description des actions menées *</label>
                <textarea name="description" rows="2" required placeholder="Ex: Vermifugation de tous les adultes avec produit X, ou Compte-rendu de la visite vétérinaire..."></textarea>
            </div>

            <div class="form-grid" style="margin-top: 1rem;">
                <div class="form-group">
                    <label>Animaux concernés</label>
                    <input type="text" name="animals_concerned" placeholder="Ex: Tout l'élevage, ou Portée de Nala">
                </div>
                <div class="form-group">
                    <label>Vétérinaire intervenant</label>
                    <input type="text" name="vet_name" placeholder="Dr. Nom du Vétérinaire">
                </div>
            </div>
            
            <button type="submit" class="btn btn-secondary" style="margin-top: 1rem;">Enregistrer l'intervention</button>
        </form>

        <div style="overflow-x: auto;">
            <table class="data-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #ddd;">
                        <th style="padding: 1rem;">Date</th>
                        <th style="padding: 1rem;">Type</th>
                        <th style="padding: 1rem;">Description</th>
                        <th style="padding: 1rem;">Concerné(s)</th>
                        <th style="padding: 1rem;">Vétérinaire</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.length === 0) { %>
                        <tr><td colspan="5" style="padding: 1rem; text-align: center;">Aucun événement sanitaire enregistré.</td></tr>
                    <% } else { %>
                        <% records.forEach(record => { %>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 1rem;"><strong><%= new Date(record.event_date).toLocaleDateString('fr-FR') %></strong></td>
                                <td style="padding: 1rem;"><strong><%= record.event_type %></strong></td>
                                <td style="padding: 1rem; max-width: 300px;"><%= record.description %></td>
                                <td style="padding: 1rem;"><%= record.animals_concerned || '-' %></td>
                                <td style="padding: 1rem;"><%= record.vet_name || '-' %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

</main>

<style>
    @media print {
        body * { visibility: hidden; }
        .data-table, .data-table *, h1, h2 { visibility: visible; }
        main { position: absolute; left: 0; top: 0; width: 100%; }
        .btn, .no-print, .header-actions a { display: none !important; }
    }
</style>

<%- include('../partials/foot') %>