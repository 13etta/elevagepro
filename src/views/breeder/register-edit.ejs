<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
    const formatDateForInput = (value) => {
        if (!value) return '';
        if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}/.test(value)) {
            return value.slice(0, 10);
        }
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return '';
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    };

    const sourceTable = movement.source_table || 'animal_movements';
    const sourceRowId = movement.row_id || `${sourceTable}:${movement.id}`;
    const movementType = String(movement.movement_type || '').toUpperCase();
    const currentReason = movement.movement_reason || '';
    const entryReasons = ['Naissance', 'Naissance portée', 'Acquisition', 'Restitution', "Reprise d'historique", 'Autre'];
    const exitReasons = ['Vente', 'Décès', 'Don', 'Retraite / réforme', 'Autre'];
    const reasonList = movementType === 'ENTREE' ? entryReasons : exitReasons;
    const hasCurrentReason = currentReason && reasonList.includes(currentReason);
%>

<main class="container">
    <div class="header-actions">
        <h1>Correction du registre</h1>
        <a href="/breeder/register/entries" class="btn btn-secondary">Annuler</a>
    </div>

    <form action="/breeder/register/movements/<%= encodeURIComponent(sourceRowId) %>/edit" method="POST" class="card form-block" style="margin-top: 2rem;">
        <div class="form-grid">
            <div class="form-group">
                <label>Nom de l'animal (lecture seule)</label>
                <input type="text" value="<%= movement.animal_name || '-' %>" disabled style="background-color: #f8f9fa;">
                <small class="muted">L'animal concerné par ce mouvement ne peut être modifié.</small>
            </div>

            <div class="form-group">
                <label>Type de mouvement (lecture seule)</label>
                <input type="text" value="<%= movementType || '-' %>" disabled style="background-color: #f8f9fa;">
            </div>
        </div>

        <div class="form-grid" style="margin-top: 1.5rem;">
            <div class="form-group">
                <label>Date du mouvement *</label>
                <input type="date" name="movement_date" value="<%= formatDateForInput(movement.movement_date) %>" required>
            </div>

            <div class="form-group">
                <label>Motif *</label>
                <select name="movement_reason" required>
                    <% if (currentReason && !hasCurrentReason) { %>
                        <option value="<%= currentReason %>" selected><%= currentReason %></option>
                    <% } %>
                    <% reasonList.forEach((reason) => { %>
                        <option value="<%= reason %>" <%= currentReason === reason ? 'selected' : '' %>><%= reason %></option>
                    <% }) %>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-top: 1.5rem;">
            <label>Provenance ou destination</label>
            <input type="text" name="third_party_info" value="<%= movement.third_party_info || '' %>" placeholder="Nom et adresse de l'acheteur ou du vendeur">
            <small class="muted">Information obligatoire en cas de vente ou d'achat pour la DDPP.</small>
        </div>

        <div class="form-group" style="margin-top: 1.5rem;">
            <label>Observations diverses</label>
            <textarea name="notes" rows="3" placeholder="Notes complémentaires (numéro de contrat, circonstances particulières...)"><%= movement.notes || '' %></textarea>
        </div>

        <div style="margin-top: 2rem;">
            <button type="submit" class="btn btn-primary" style="padding: 1rem 2rem;">Mettre à jour le registre</button>
        </div>
    </form>
</main>

<%- include('../partials/foot') %>