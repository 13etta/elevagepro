# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=

# Modules expérimentaux Génétique, CYNOGNOSTIC et Stratégie de reproduction.
# Ils restent désactivés par défaut tant que leur validation métier n'est pas terminée.
ENABLE_SELECTION_MODULES=false

# Nouvel agent de sélection par pedigree (indépendant des anciens modules expérimentaux).
ENABLE_AI_SELECTION_AGENT=true

# PostgreSQL / Supabase connection
DATABASE_URL=
DATABASE_SSL=true
PG_FORCE_IPV4=false
RUN_DEMO_SEED=false

# Supabase Storage (publishable values only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DOG_PHOTO_BUCKET=logos
SUPABASE_PUBLIC_BUCKET=logos

# Elevage configuration
KENNEL_BOX_CAPACITY=12
BOX_CAPACITY=12
STATGESCON_BASE_URL=https://statgescon.onrender.com

# Optional AI provider
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_SELECTION_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=

