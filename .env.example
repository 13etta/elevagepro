# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=

# Modules expérimentaux Génétique, CYNOGNOSTIC et Stratégie de reproduction.
# Ils restent désactivés par défaut tant que leur validation métier n'est pas terminée.
ENABLE_SELECTION_MODULES=false

# Nouvel agent de sélection par pedigree (indépendant des anciens modules expérimentaux).
ENABLE_AI_SELECTION_AGENT=true
AI_SELECTION_OWNER_USER_ID=83b1656c-57b9-4e46-a79c-7203710c4a41

# PostgreSQL / Supabase connection
DATABASE_URL=
DATABASE_SSL=true
PG_FORCE_IPV4=false
RUN_DEMO_SEED=false

# Supabase Storage (publishable values only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DOG_PHOTO_BUCKET=logos
SUPABASE_PUBLIC_BUCKET=logos

# Elevage configuration
KENNEL_BOX_CAPACITY=12
BOX_CAPACITY=12
STATGESCON_BASE_URL=https://statgescon.onrender.com

# Optional AI provider
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_SELECTION_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=

# Private certificates: mount a persistent disk here on Render/Docker.
PRIVATE_UPLOAD_DIR=
# Optional provider CA certificate, with literal \n separators or PEM newlines.
DATABASE_CA_CERT=

# Reuse the existing database. db:check is read-only; db:upgrade needs its hostname.
MIGRATION_CONFIRM_HOST=
TRUST_PROXY_HOPS=0
PUBLIC_UPLOAD_DIR=
APP_BASE_URL=http://localhost:3000

# Stripe: recurring EUR 7.00/month price; secrets belong only in server configuration.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Password reset email, with a verified sender and authenticated SMTP over TLS.
SMTP_URL=
MAIL_FROM=
